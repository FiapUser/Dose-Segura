# =============================================================================
# DOSE SEGURA - variaveis de ambiente
# Copie para .env e ajuste. Usado pelo docker compose (local) e como referencia
# para o painel do Render (producao).
# =============================================================================

# ------------------------------- aplicacao -----------------------------------
APP_PORT=8080

# ---------------------------------- MySQL ------------------------------------
# Local: o compose cria o container db-dose-segura com esses valores.
# Producao (Aiven): cole em DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD os
# dados exibidos em "Connection" no painel do Aiven.
DB_NAME=dosesegura
DB_USER=usr
DB_PASSWORD=123
DB_ROOT_PASSWORD=root
DB_PORT_EXTERNAL=3307
# Aiven exige TLS (deixe true). No MySQL local do compose, false.
DB_SSL=false

# -------------------------------- Cloudinary ---------------------------------
# Identificacao da conta: cloud name, api key e api secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dose-segura

# ---------------------------------- JWT --------------------------------------
# Base64 de pelo menos 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=

# --------------------------------- CORS -------------------------------------
# So e necessario em desenvolvimento (Vite em 5173). Em producao o front e
# servido pelo proprio Spring, entao nao ha CORS.
CORS_ORIGENS=http://localhost:5173,http://localhost:4173

# --------------------------- carga inicial ----------------------------------
DOSEGURA_SEED_ENABLED=true
MASTER_ADMIN_EMAIL=admin@dosesegura.com.br
MASTER_ADMIN_SENHA=DoseSegura@2026
# Conta de instituicao: administra os registros deste CNPJ e envia as imagens.
DEMO_INSTITUICAO_EMAIL=parceira@dose-segura.com.br
DEMO_INSTITUICAO_SENHA=Parceira@2026
DEMO_INSTITUICAO_CNPJ=61.774.267/0001-00
